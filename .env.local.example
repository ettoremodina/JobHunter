# Copy this file to .env.local and insert your API keys there.
# .env.local is ignored by Git. Existing .env is NOT used by this integration.

# Qwen su DashScope: giudizio remoto, schede dei ruoli e schede aziendali.
JOBHUNTER_API_KEY=

# TypeSafe Jev: scelta dei ruoli e settore dell'azienda nella stessa richiesta.
# Crea .env.local, incolla la chiave dopo il segno = e non versionare quel file.
TYPESAFE_API_KEY=
