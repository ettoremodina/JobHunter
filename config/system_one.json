{
  "provider": "typesafe",
  "endpoint": "https://api.typesafe.ai/v1/systemone",
  "model": "jev-latest",
  "api_key_env": "TYPESAFE_API_KEY",
  "secrets_file": ".env.local",
  "schema_version": "1",
  "timeout_seconds": 60,
  "max_response_bytes": 400000,
  "questions_path": "config/system-one-questions.json",
  "output_directory": "data/system-one",
  "default_limit": 50,
  "max_limit": 25000,
  "workers": 4,
  "max_workers": 64,
  "max_requests_per_minute": 60,
  "max_attempts": 4,
  "checkpoint_seconds": 2,
  "max_evidence_options": 255,
  "max_state_chars": 60000,
  "company": {
    "max_jobs": 3,
    "max_chars": 24000
  },
  "thresholds": {
    "keep_above": 0.75,
    "exclude_below": 0.2,
    "flag_above": 0.75,
    "choice_confidence": 0.6
  }
}
