{
  "database": "data/jobhunter.sqlite3",
  "raw_directory": "data/collection",
  "page_size": 30,
  "port": 8000,
  "timeout_seconds": 25,
  "max_pages": 12,
  "max_jobs": 100,
  "request_delay_seconds": 1,
  "refresh_hours": 24,
  "stale_after_days": 30,
  "sources": {
    "jobspy": {
      "enabled": true,
      "kind": "jobspy",
      "config": "config/jobspy.yaml"
    },
    "airtable": {
      "enabled": true,
      "kind": "airtable",
      "config": "config/airtable.yaml"
    },
    "ats": {
      "enabled": true,
      "kind": "ats",
      "config": "config/ats_watchlist.json",
      "workers": 8,
      "request_interval_seconds": 0.2,
      "max_jobs_per_board": 3000,
      "discovery": {
        "tiers": [
          "A",
          "B-attesa",
          "B-esperienza"
        ],
        "recheck_days": 30,
        "workers": 16,
        "probe_interval_seconds": 1.0,
        "timeout_seconds": 15
      }
    },
    "climatebase.org": {
      "enabled": false,
      "kind": "browser",
      "reason": "Protetto dalla verifica anti-bot di Cloudflare dal settembre 2026 (403 «Just a moment...» anche col browser); le sue aziende si seguono dalle bacheche ATS",
      "config": "config/sites/climatebase.org.yaml",
      "link_contains": "/job/"
    },
    "inclimate.com": {
      "enabled": false,
      "kind": "browser",
      "reason": "Accesso richiesto: paywall segnalato dall'utente",
      "config": "config/sites/inclimate.com.yaml",
      "link_contains": "/jobs/"
    }
  }
}
