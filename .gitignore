# Segreti: mai versionati.
.env
.env.local

# Dati locali: archivio SQLite, snapshot HTML, report, backup, benchmark.
# Restano sul disco, non su GitHub. Il backup e' una tua copia, non il repo.
data/

*.log
.venv/
__pycache__/
*.pyc
.pytest_cache/


# File personali: restano sul tuo disco. `python main.py init` li crea da examples/.
/user_context/
/config/role_filters.json
/config/jobspy.yaml
/config/system-one-questions.json
/config/review_questions.json
/config/ats_watchlist.json

# Ambiente personale degli agenti e appunti di lavoro: privati.
/.agents/
/.claude/
/AGENTS.md
/CLAUDE.md
/TO-DO.md
/.tmp/
/.vscode/

# >>> agentworkflow
# Shared skills are links to AgentWorkflow, recreated by its scripts/project.ps1 -Action Link.
# Project-owned skills stay tracked through the exceptions below.
.agents/skills/*
!.agents/skills/dashboard-template/
.agents/memory/global/
.claude/skills
.claude/memory
.claude/settings.local.json
# <<< agentworkflow
